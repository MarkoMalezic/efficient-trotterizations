    family-names: Maležič
    orcid: "https://orcid.org/0009-0005-5863-9223"
    affiliation: "University of Bonn, Helmholtz Institute for Radiation and Nuclear Physics"
repository-code: "https://github.com/MarkoMalezic/efficient-trotterizations"
license: MIT
keywords:
  - Trotter-Suzuki decomposition
  - product formulas
  - symplectic integrators
  - quantum simulation
  - Hamiltonian simulation
