Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"cmtt", "[", 
      RowBox[{"{", 
       RowBox[{"b_", ",", "a_"}], "}"}], "]"}], ":=", 
     RowBox[{"Cmt", "[", 
      RowBox[{"b", ",", "a"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"cmtt", "[", 
      RowBox[{"{", 
       RowBox[{"a_", ",", "h___"}], "}"}], "]"}], ":=", 
     RowBox[{"Cmt", "[", 
      RowBox[{"a", ",", 
