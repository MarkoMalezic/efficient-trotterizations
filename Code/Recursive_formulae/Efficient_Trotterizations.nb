a5c7fd708764"],

Cell["\<\
The  following  algorithm  allows  us  to  transform  any  Lie  word  a  \
desired  basis, which  is  helpful  for  the  derivation  of  recursive  \
formulae.\
\>", "Text",
 CellChangeTimes->{{3.977486905462562*^9, 
  3.977486911775247*^9}},ExpressionUUID->"29dfd093-2a7b-4f45-9d54-\
4bf55f228115"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "ExtractMonomials", ",", "WordPerms", ",", "ExprToVec", ",", 
    "TransformWord"}], "]"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Helper", " ", "to", " ", "extract", " ", "the", " ", "words", " ", "and", 
    " ", "their", " ", "coefficients", " ", "from", " ", "an", " ", 
    "expression"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ExtractMonomials", "[", "expr_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"terms", ",", 
        RowBox[{"monos", "=", 
         RowBox[{"{", "}"}]}], ",", "coeff", ",", "word"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"terms", "=", 
        RowBox[{"List", "@@", "expr"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", 
          RowBox[{"Length", "[", "terms", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"term", "=", 
           RowBox[{"terms", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Head", "[", "term", "]"}], "===", "Times"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"parts", "=", 
              RowBox[{"List", "@@", "term"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"coeff", "=", 
              RowBox[{"parts", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"word", "=", 
              RowBox[{"List", "@@", 
               RowBox[{"parts", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], 
            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"coeff", "=", "1"}], ";", "\[IndentingNewLine]", 
             RowBox[{"word", "=", 
