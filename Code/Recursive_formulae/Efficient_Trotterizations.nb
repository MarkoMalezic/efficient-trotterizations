   "Helper", " ", "to", " ", "generate", " ", "all", " ", "the", " ", "words",
     " ", "for", " ", "a", " ", "given", " ", "m", " ", "and", " ", "j"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"WordPerms", "[", 
