 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ExprToVec", "[", 
     RowBox[{"expr_", ",", "m_", ",", "j_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vec", ",", "monos", ",", "words", ",", "pos"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"monos", "=", 
        RowBox[{"ExtractMonomials", "[", "expr", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"words", "=", 
        RowBox[{"WordPerms", "[", 
         RowBox[{"m", ",", "j"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"vec", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"Length", "[", "words", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", 
