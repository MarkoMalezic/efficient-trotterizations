e3451f02de6c"],

Cell["\<\
The  following  algorithm  was  developed  by  Arnal  et  al . in  their  \
paper  \[OpenCurlyDoubleQuote]C. A Note on the \
Baker\[Dash]Campbell\[Dash]Hausdorff Series in Terms of Right-Nested \
Commutators\[CloseCurlyDoubleQuote].
It  generates  a  basis  for  symmetric  and  asymmetric  schemes  in  terms  \
of  right - nested  commutators, which  allows  us  to  compute  our  basis  \
coefficients.\
\>", "Text",
 CellChangeTimes->{{3.977486858722166*^9, 
  3.977486888668545*^9}},ExpressionUUID->"88c73370-7ac9-479f-bca2-\
0b9da8f94c78"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fact", "[", 
    RowBox[{"n_", ",", "m_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Product", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"k", "[", "j", "]"}], "!"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", 
        RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"m", "-", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"k", "[", "j", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ")"}], "!"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"table", "[", 
    RowBox[{"{", "h___", "}"}], "]"}], ":=", 
   RowBox[{"Table", "[", "h", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"intable", "[", 
    RowBox[{"n_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Join", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"X", "[", "j", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"r", "[", "j", "]"}], ",", "1", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"j", "==", "n"}], ",", 
            RowBox[{"m", "-", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{"k", "[", "j", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "1", ",", 
                 RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ",", 
            RowBox[{"k", "[", "j", "]"}]}], "]"}]}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"count", "[", 
    RowBox[{"n_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"k", "[", "j", "]"}], ",", "0", ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"j", "==", "1"}], ",", "m", ",", 
         RowBox[{"m", "-", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"k", "[", "i", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"j", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Phinm", "[", "f_", "]"}], "[", 
     RowBox[{"n_", ",", "m_"}], "]"}], "[", 
    RowBox[{"{", "counter___", "}"}], "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"fact", "[", 
        RowBox[{"n", ",", "m"}], "]"}]}], 
      RowBox[{"f", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"table", "[", 
             RowBox[{
              RowBox[{"intable", "[", 
               RowBox[{"n", ",", "m"}], "]"}], "[", 
              RowBox[{"[", "j", "]"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}], ",", 
         "2"}], "]"}], "]"}]}], ",", "counter"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Phi", "[", "f_", "]"}], "[", "m_", "]"}], "[", 
    RowBox[{"{", "h___", "}"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Phinm", "[", "f", "]"}], "[", 
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"{", "h", "}"}], "]"}], ",", "m"}], "]"}], "[", 
     RowBox[{"count", "[", 
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"{", "h", "}"}], "]"}], ",", "m"}], "]"}], "]"}], "/.", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"X", "[", "j", "]"}], "->", 
       RowBox[{
        RowBox[{"{", "h", "}"}], "[", 
        RowBox[{"[", "j", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", 
        RowBox[{"Length", "[", 
         RowBox[{"{", "h", "}"}], "]"}]}], "}"}]}], "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.977486482901374*^9, 
  3.977486679237146*^9}},ExpressionUUID->"a90bc232-e110-42bf-85db-\
7924fb743cae"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"s", "[", "n_", "]"}], ":=", 
   RowBox[{"Permutations", "[", 
    RowBox[{"Range", "[", 
     RowBox[{"1", ",", "n"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coef", "[", "p_", "]"}], ":=", 
   RowBox[{
    RowBox[{"coef", "[", "p", "]"}], "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"b", ",", "n"}], "}"}], ",", 
      RowBox[{
       RowBox[{"b", "=", "0"}], ";", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "p", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"p", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ">", 
            RowBox[{"p", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
           RowBox[{"b", "=", 
            RowBox[{"b", "+", "1"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", "b"}], "/", 
        RowBox[{"(", 
         RowBox[{"n", " ", 
          RowBox[{"Binomial", "[", 
           RowBox[{
            RowBox[{"n", "-", "1"}], ",", "b"}], "]"}]}], ")"}]}]}]}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ei", "[", 
    RowBox[{"{", "h___", "}"}], "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"coef", "[", 
       RowBox[{
        RowBox[{"s", "[", 
         RowBox[{"Length", "[", 
          RowBox[{"{", "h", "}"}], "]"}], "]"}], "[", 
        RowBox[{"[", "j", "]"}], "]"}], "]"}], 
      RowBox[{"Apply", "[", 
       RowBox[{"Mm", ",", 
        RowBox[{
         RowBox[{"Permutations", "[", 
          RowBox[{"{", "h", "}"}], "]"}], "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"{", "h", "}"}], "]"}], "!"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ei", "[", 
    RowBox[{"{", "h___", "}"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"ei", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"x", "[", "i", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"{", "h", "}"}], "]"}]}], "}"}]}], "]"}], "]"}], "/.", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "[", "j", "]"}], "->", 
       RowBox[{
        RowBox[{"{", "h", "}"}], "[", 
        RowBox[{"[", "j", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", 
        RowBox[{"Length", "[", 
         RowBox[{"{", "h", "}"}], "]"}]}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PhiMm", "[", "m_", "]"}], "[", 
