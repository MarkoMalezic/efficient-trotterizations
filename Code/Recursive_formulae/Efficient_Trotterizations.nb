Cell[TextData[{
 "BCH in compact basis (Arnal ",
 StyleBox["et al. 2021",
  FontSlant->"Italic"],
 ")\n",
 StyleBox["Algorithm to compute the BCH in terms of right-nested commutators",
   "Subtitle"]
}], "Section",
 CellChangeTimes->{{3.945243412061385*^9, 3.945243413354456*^9}, {
   3.945243474470427*^9, 3.945243600307813*^9}, {3.975480025089523*^9, 
