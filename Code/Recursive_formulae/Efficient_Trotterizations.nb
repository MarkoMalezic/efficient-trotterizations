         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"pos", "=", 
           RowBox[{"Position", "[", 
            RowBox[{"words", ",", 
             RowBox[{"monos", "[", 
