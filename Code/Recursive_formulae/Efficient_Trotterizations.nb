Cell[TextData[{
 "Right-nested transformation\n",
 StyleBox["Algorithm to transform a Lie word into a sum of right-nested \
commutators", "Subtitle"]
}], "Section",
 CellChangeTimes->{{3.945243412061385*^9, 3.945243413354456*^9}, {
