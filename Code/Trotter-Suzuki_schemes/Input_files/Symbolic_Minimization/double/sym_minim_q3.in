# Routine and mode specification
routine = 0
mode = 1
scalar_type = double

# Save directory path (if empty no writing occurs)
#save_dir = ../../../Data/Symbolic_Minimization/double/

# General parameters
order = 4
no_cycles = 3

# Specific parameters
method = find
a_init = -0.1, 1.1
b_init = -1.5, 2.5
#load_dir = ../../../Data/Symbolic_Scheme/double/saved_schemes/
bderivs = true
# Minimization hyperparameters
eps1 = 1e-15, 1e-15, 1e-30, 0.0
eps2 = 1e-22, 1e-22, 0.0, 0.0
wi = 1.0, 1e-1
n_iter = 1000
Ls = 9.0, 11.0
lambda = 0.25
# Minima finder parameters
N = 100
steps = 2
#threshold = 1.0
mu = 0.0
sigma = 2.0
#des_prob = 
#bsort = 
# Verbose option
verbose = 0
# Minima comparison parameter
tol = 1e-8
# Hessian freeze option
freeze = 0
